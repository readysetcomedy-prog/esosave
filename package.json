{
  "name": "esosave",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that keeps every ESO EHR change on the device until ESO confirms it saved, warns when signal drops, and pushes everything back when it returns.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "mock": "node test/mock-eso/server.mjs",
    "test": "node scripts/build.mjs && node --test test/e2e.test.mjs",
    "test:inline": "node scripts/build.mjs && ESOSAVE_EXT_DIR=dist/test-inline node --test test/e2e.test.mjs",
    "test:recording": "node scripts/build.mjs && node --test test/recording.test.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
