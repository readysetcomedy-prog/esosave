{
  "expo": {
    "name": "ESO Save",
    "slug": "esosave",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ruralmedems.esosave",
      "appleTeamId": "UG9SN323ZU",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "ESO Save uses Bluetooth only for the optional monitor test, to list what a paired monitor exposes.",
          "neverForLocation": true
        }
      ]
    ]
  }
}
