{
  "expo": {
    "name": "ESO Save",
    "slug": "esosave",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ruralmedems.esosave",
      "appleTeamId": "UG9SN323ZU",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ESO Save uses the camera to scan paperwork (facesheets, certifications, med lists, monitor printouts) onto the run open in Safari."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ruralmedems.esosave"
        ]
      }
    },
    "plugins": [
      "@bacons/apple-targets",
      "react-native-document-scanner-plugin"
    ],
    "scheme": "esosave",
    "extra": {
      "eas": {
        "projectId": "bb6a1ca8-eb4c-43d7-8c18-dabbe88d6a81"
      }
    }
  }
}
